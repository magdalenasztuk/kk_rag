ANTHROPIC_API_KEY=
# GEMINI_API_KEY=...            # gdy KOMPAS_LLM_PROVIDER=gemini
# VOYAGE_API_KEY=...            # gdy KOMPAS_EMBEDDING_PROVIDER=voyage
KOMPAS_LLM_PROVIDER=anthropic   # anthropic | gemini | ollama | mock
KOMPAS_ANSWER_MODEL=anthropic/claude-sonnet-5-5
KOMPAS_FAST_MODEL=anthropic/claude-haiku-5-5
KOMPAS_EMBEDDING_MODEL=BAAI/bge-m3
KOMPAS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KOMPAS_ABSTAIN_THRESHOLD=0.30
KOMPAS_ADMIN_TOKEN=change-me
# Podpis tokenów logowania (HMAC). Na Vercel ustaw losowy ciąg.
# KOMPAS_AUTH_SECRET=zmien-mnie
# KOMPAS_AUTH_TTL_HOURS=12

# Wdrożenie bez modeli lokalnych (Vercel): samo BM25 + parafrazy zapytań z Claude Haiku.
# KOMPAS_DENSE_ENABLED=false
# KOMPAS_USE_RERANKER=false

# Stan aplikacji (sprawy, powiadomienia) — Postgres (np. Neon z integracji Vercel). Bez tego: SQLite.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Adresy frontu dopuszczone przez CORS (JSON), gdy front woła API bezpośrednio, a nie przez rewrite.
# KOMPAS_CORS_ORIGINS=["http://localhost:4200"]
